{
  "name": "@rawwee/react-pdf-html",
  "version": "2.1.0",
  "description": "Package for rendering @react-pdf/renderer components as HTML components",
  "sideEffects": true,
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josippapez/react-pdf-html.git"
  },
  "keywords": [
    "React",
    "React-PDF",
    "PDF"
  ],
  "author": "Josip Papež",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/josippapez/react-pdf-html/issues"
  },
  "homepage": "https://github.com/josippapez/react-pdf-html#readme",
  "peerDependencies": {
    "@react-pdf/renderer": "^3.4.4 || ^4.0.0",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
